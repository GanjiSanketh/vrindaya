rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'gsanketh7121@gmail.com';
    }

    match /marketingSubscribers/{mobileNumber} {
      allow create: if
        mobileNumber.matches('^[6-9][0-9]{9}$')
        && request.resource.data.mobileNumber == mobileNumber
        && request.resource.data.consent == true
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.source is string
        && (!('firstName' in request.resource.data)
            || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
             request.resource.data.keys().hasOnly(
               ['mobileNumber', 'firstName', 'source', 'status', 'consent', 'createdAt', 'updatedAt']
             )
             || (
                  isAdminUser()
                  && request.resource.data.importedBy is string
                  && request.resource.data.importedAt == request.time
                  && request.resource.data.keys().hasOnly(
                       ['mobileNumber', 'firstName', 'source', 'status', 'consent', 'createdAt', 'updatedAt', 'importedBy', 'importedAt']
                     )
                )
           );
      allow get: if true;
      allow list, update, delete: if isAdminUser();
    }

    match /products/{productId} {
      allow get, list: if isAdminUser() || resource.data.active == true;
      allow create, update, delete: if isAdminUser();
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // Product Analytics — anonymous visitors / customer users (unauthenticated)
    // increment counters. Admin sessions are denied at the rules level so admin
    // browsing can never pollute metrics, even if a client-side check is missed.
    match /analytics/productAnalytics/{productId} {
      allow read: if isAdminUser();
      allow create, update: if request.auth == null || !isAdminUser();
      allow delete: if isAdminUser();
      match /daily/{day} {
        allow read: if isAdminUser();
        allow create, update: if request.auth == null || !isAdminUser();
        allow delete: if isAdminUser();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
