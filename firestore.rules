rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdminUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'gsanketh7121@gmail.com';
    }

    // The master analytics kill-switch document (analyticsSettings/website).
    // get()/exists() fail when the document is missing, so every check below
    // is FAIL-CLOSED: no analytics write is allowed until an admin has saved
    // settings that explicitly enable tracking. The browser may read this
    // document (allow read: if true below) so the rules can use it.
    function analyticsSettingsDoc() {
      return /databases/$(database)/documents/analyticsSettings/website;
    }

    // Global kill-switch — when OFF, NOTHING is recorded, at the database level.
    function analyticsTrackingEnabled() {
      return get(analyticsSettingsDoc()).data.trackingEnabled == true;
    }

    // Per-feature switch for a collection, e.g. productClicks for `analytics`.
    function analyticsToggleOn(field) {
      return get(analyticsSettingsDoc()).data[field] == true;
    }

    match /marketingSubscribers/{mobileNumber} {
      allow create: if
        mobileNumber.matches('^[6-9][0-9]{9}$')
        && request.resource.data.mobileNumber == mobileNumber
        && request.resource.data.consent == true
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.source is string
        && (!('firstName' in request.resource.data)
            || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50))
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
             request.resource.data.keys().hasOnly(
               ['mobileNumber', 'firstName', 'source', 'status', 'consent', 'createdAt', 'updatedAt']
             )
             || (
                  isAdminUser()
                  && request.resource.data.importedBy is string
                  && request.resource.data.importedAt == request.time
                  && request.resource.data.keys().hasOnly(
                       ['mobileNumber', 'firstName', 'source', 'status', 'consent', 'createdAt', 'updatedAt', 'importedBy', 'importedAt']
                     )
                )
           );
      allow get: if true;
      allow list, update, delete: if isAdminUser();
    }

    match /products/{productId} {
      allow get, list: if isAdminUser() || resource.data.active == true;
      allow create, update, delete: if isAdminUser();
    }

    match /productVariants/{variantId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    /**
     * Hero banners — the homepage reads the active banner straight from
     * Firestore, so reads must be public. Only Admin / Super Admin may
     * write (uploaded image URLs + publish state), matching the
     * AdminOnly authorization policy on the API endpoints.
     */
    match /heroBanners/{docId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    /**
     * Homepage configuration (homepageConfig/active) — the CMS record that
     * drives the homepage. Public reads (the storefront hero showcase reads
     * it straight from Firestore, exactly like heroBanners); writes only by
     * Admin / Super Admin via the AdminOnly policy on the API.
     */
    match /homepageConfig/{docId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // Product Analytics — anonymous visitors / customer users (unauthenticated)
    // increment counters. Admin sessions are denied at the rules level so admin
    // browsing can never pollute metrics. Writes additionally require the
    // settings document to explicitly enable tracking AND productClicks — this
    // is the server-side enforcement that holds even if a client-side check is
    // missed or a stale build keeps sending events.
    match /analytics/{productId} {
      allow read: if isAdminUser();
      allow create, update: if
        (request.auth == null || !isAdminUser())
        && analyticsTrackingEnabled()
        && analyticsToggleOn('productClicks');
      allow delete: if isAdminUser();
      match /daily/{day} {
        allow read: if isAdminUser();
        allow create, update: if
          (request.auth == null || !isAdminUser())
          && analyticsTrackingEnabled()
          && analyticsToggleOn('productClicks');
        allow delete: if isAdminUser();
      }
    }

    /**
     * Website analytics configuration (analyticsSettings/website) — the
     * storefront subscribes to live updates (public read, so onSnapshot and
     * the rules' get() below both work); only Admin / Super Admin may modify
     * it. This document is the server-side source of truth for the
     * analytics write gates in this file.
     */
    match /analyticsSettings/{docId} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    /**
     * Site-wide analytics (hero/category/collection/nav/footer clicks, page
     * views, scroll + search events). Anonymous visitors / customer users
     * increment the counters; admin sessions are denied at the rules level
     * so admin browsing can never pollute metrics. The shared totals/daily
     * counters are gated by the global trackingEnabled switch (the per-feature
     * toggles for these shared docs are enforced client-side, since a single
     * shared document carries many counters); the dedicated searches /
     * performance sub-collections are gated by their own toggle as well.
     */
    match /siteAnalytics/{docId} {
      allow read: if isAdminUser();
      allow create, update: if
        (request.auth == null || !isAdminUser())
        && analyticsTrackingEnabled();
      allow delete: if isAdminUser();
      match /daily/{day} {
        allow read: if isAdminUser();
        allow create, update: if
          (request.auth == null || !isAdminUser())
          && analyticsTrackingEnabled();
        allow delete: if isAdminUser();
      }
      match /searches/{key} {
        allow read: if isAdminUser();
        allow create, update: if
          (request.auth == null || !isAdminUser())
          && analyticsTrackingEnabled()
          && analyticsToggleOn('searchTracking');
        allow delete: if isAdminUser();
      }
      match /performance/{day} {
        allow read: if isAdminUser();
        allow create, update: if
          (request.auth == null || !isAdminUser())
          && analyticsTrackingEnabled()
          && analyticsToggleOn('performanceTracking');
        allow delete: if isAdminUser();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
