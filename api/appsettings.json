{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://vrindaya.vercel.app"
    ]
  },
  "Firebase": {
    "ServiceAccountPath": "Firebase/serviceAccount.json",
    "ProjectId": "vrindaya-ad7b0"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "WhatsApp": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "VerifyToken": "",
    "ApiVersion": "v23.0"
  },
  "CampaignDelivery": {
    "BatchSize": 20,
    "PollingIntervalSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
