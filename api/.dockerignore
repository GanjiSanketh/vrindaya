# Build output — regenerated by the Dockerfile's own build stage, never
# copied in from the host.
bin/
obj/
**/bin/
**/obj/

# Editor/IDE state — irrelevant to the image, and .vs/ in particular can
# be large.
.vs/
.vscode/
*.user
*.suo

# Not part of this repo layout, but excluded defensively in case this
# Dockerfile is ever built with a wider context than api/.
.git/
node_modules/

# Real Firebase credentials must never be baked into an image layer —
# production reads FIREBASE_SERVICE_ACCOUNT_JSON instead (see
# docs/deployment/render.md). This also protects the (git-ignored, but
# not necessarily docker-ignored by default) local dev file.
Firebase/serviceAccount.json

# Local-only secrets, same reasoning as .gitignore.
appsettings.Development.json
appsettings.*.local.json
*.local.json

# Temporary/OS files.
*.log
*.tmp
.DS_Store
Thumbs.db
